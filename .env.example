# console.anthropic.com > API Keys  (AI küfür filtresi + abone doğrulama için)
GEMINI_API_KEY=

# Sunucu ID'n (komutlar anında görünsün diye). Boş bırakırsan global sync olur (1 saate kadar sürebilir)
